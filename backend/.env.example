# 9router (OpenAI-compatible endpoint)
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=gcli/grok-4.7
# comma-separated, tried in order if the main model fails
NINEROUTER_FALLBACK_MODELS=gemini/gemini-3.8-flash
# models selectable in the web UI (comma-separated)
NINEROUTER_MODEL_CHOICES=gcli/grok-4.7,gcli/grok-4.7-high,gemini/gemini-3.8-flash,gemini/gemini-3.5-flash-lite,dahl/MiniMaxAI/MiniMax-M2.7
# seconds per model attempt; long 16:9 stories can take several minutes
LLM_TIMEOUT_SECONDS=900

# Where projects + images are saved (relative to backend/)
OUTPUT_DIR=../output

# ~seconds of narration per scene (1 image = 1 narration chunk)
SECONDS_PER_SCENE=7

# Human-like pacing used by the extension (seconds)
DELAY_BETWEEN_IMAGES_MIN=20
DELAY_BETWEEN_IMAGES_MAX=60
# A scene stuck in "generating" longer than this is marked failed
JOB_TIMEOUT_SECONDS=300

# ==========================================
# Narration audio (TTS) & Network
# ==========================================
# Bind address. 127.0.0.1 = this machine only; 0.0.0.0 lets a TTS worker on another PC (Tailscale) connect
HOST=127.0.0.1

# Shared secret for TTS workers on other machines (set the same value in worker-tts/.env there)
TTS_WORKER_TOKEN=
# local | auto | remote  (auto: this machine's worker skips models an online remote worker has)
TTS_WORKER_MODE=auto
# Voice library folder (relative to backend/)
VOICES_DIR=data/voices
# manhwa-recap-studio database to import voices from
LEGACY_STUDIO_DB=~/Documents/Coding/Python/manhwa-recap-studio/data/studio.db

# ==========================================
# Cloudflare D1 (Database) & R2 (Media)
# ==========================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=stickman-genarator
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Target alert backup (default: 30)
BACKUP_PROJECT_THRESHOLD=30

# Google Drive Backup (Isolated Configuration)
GDRIVE_EMAIL=aseplandak02@gmail.com
GDRIVE_REMOTE_NAME=gdrive_stickman
GDRIVE_FOLDER_NAME=StickmanGeneratorArchive
GDRIVE_BACKUP_DESTINATION=gdrive_stickman:StickmanGeneratorArchive
RCLONE_CONFIG_PATH=data/rclone.conf
