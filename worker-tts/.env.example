# Backend this worker takes jobs from. Same machine: keep the default.
# Remote PC: http://<tailscale-ip-of-the-machine-running-the-app>:8000
TTS_SERVER=http://127.0.0.1:8000
# Must match TTS_WORKER_TOKEN in backend/.env (not needed when the worker runs on the same machine)
TTS_WORKER_TOKEN=
# Shown in the app's worker badge (default: computer name)
TTS_WORKER_NAME=
# Hugging Face model cache. Point it at an existing cache to avoid re-downloading, e.g.
# ../manhwa-recap-studio/models/checkpoints/hf_cache
TTS_HF_CACHE=
# VoxCPM2: torch.compile + CUDA graphs (needs triton; Windows also needs MSVC). Off by default.
VOXCPM_OPTIMIZE=false
